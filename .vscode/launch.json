{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI: Heart Disease API",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "heart_disease_pca.api:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "jinja": true
    },
    {
      "name": "Train Model",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/train_model.py",
      "cwd": "${workspaceFolder}"
    }
  ]
}
